# --- ИИ-провайдер ---
# По умолчанию OpenRouter (есть бесплатные модели). Ключ: openrouter.ai/keys
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-v1-...

# Модель. Бесплатные варианты OpenRouter (с поддержкой инструментов):
#   meta-llama/llama-3.3-70b-instruct:free
#   google/gemini-2.0-flash-exp:free
# Платные (надёжнее держат диалог и подбор):
#   openai/gpt-4o-mini
#   anthropic/claude-3.5-sonnet
MODEL_ID=meta-llama/llama-3.3-70b-instruct:free

# Чтобы вместо OpenRouter использовать напрямую OpenAI/ChatGPT:
#   LLM_BASE_URL=https://api.openai.com/v1
#   LLM_API_KEY=sk-...
#   MODEL_ID=gpt-4o-mini

# Необязательно — для рейтинга приложения в OpenRouter
APP_URL=
APP_NAME=Real Estate AI Agent

# --- Сервер ---
HOST=0.0.0.0
PORT=8000

# CORS: домены компаний-клиентов. "*" — для разработки. В проде — список через запятую:
# ALLOWED_ORIGINS=https://client1.com,https://client2.de
ALLOWED_ORIGINS=*

# --- Google Sheets (опционально) ---
# Путь к JSON сервисного аккаунта Google.
# Если не задан — лиды пишутся в data/leads.jsonl и/или на вебхук (n8n).
GOOGLE_SERVICE_ACCOUNT_FILE=

# --- Каталог с тенантами (компаниями) ---
TENANTS_DIR=tenants
