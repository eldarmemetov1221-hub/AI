# --- ИИ-провайдер ---
# По умолчанию OpenRouter (есть бесплатные модели). Ключ: openrouter.ai/keys
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-v1-...

# Модель. Агент работает с ЛЮБОЙ чат-моделью (инструменты не требуются),
# поэтому подойдут бесплатные модели OpenRouter. Бесплатные модели периодически
# меняются — актуальный список: https://openrouter.ai/models?max_price=0
# Примеры бесплатных:
#   deepseek/deepseek-chat-v3-0324:free
#   google/gemini-2.0-flash-exp:free
#   meta-llama/llama-3.1-8b-instruct:free
# Универсальный автовыбор (не бесплатный, но всегда доступен):
#   openrouter/auto
# Платные, самые надёжные (копейки за разговор):
#   openai/gpt-4o-mini
MODEL_ID=deepseek/deepseek-chat-v3-0324:free

# Чтобы вместо OpenRouter использовать напрямую OpenAI/ChatGPT:
#   LLM_BASE_URL=https://api.openai.com/v1
#   LLM_API_KEY=sk-...
#   MODEL_ID=gpt-4o-mini

# Необязательно — для рейтинга приложения в OpenRouter
APP_URL=
APP_NAME=Real Estate AI Agent

# --- Сервер ---
HOST=0.0.0.0
PORT=8000

# CORS: домены компаний-клиентов. "*" — для разработки. В проде — список через запятую:
# ALLOWED_ORIGINS=https://client1.com,https://client2.de
ALLOWED_ORIGINS=*

# --- Google Sheets (опционально) ---
# Путь к JSON сервисного аккаунта Google.
# Если не задан — лиды пишутся в data/leads.jsonl и/или на вебхук (n8n).
GOOGLE_SERVICE_ACCOUNT_FILE=

# --- Каталог с тенантами (компаниями) ---
TENANTS_DIR=tenants
