# --- Claude API ---
# Ключ с console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Модель агента.
#  - claude-opus-5    : максимальное качество (дороже)
#  - claude-sonnet-5  : рекомендуется для продакшена — дешевле, отлично держит диалог
MODEL_ID=claude-sonnet-5

# --- Сервер ---
HOST=0.0.0.0
PORT=8000

# CORS: домены компаний-клиентов, которым разрешено обращаться к API.
# "*" — для разработки. В проде укажи домены через запятую:
# ALLOWED_ORIGINS=https://client1.ru,https://client2.com
ALLOWED_ORIGINS=*

# --- Google Sheets (опционально) ---
# Путь к JSON-файлу сервисного аккаунта Google.
# Если не задан — лиды пишутся в data/leads.jsonl и/или на вебхук (n8n).
GOOGLE_SERVICE_ACCOUNT_FILE=

# --- Каталог с тенантами (компаниями) ---
TENANTS_DIR=tenants
